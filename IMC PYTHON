print("-"*10, 'BMI CALCULATOR!',"-"*10)
while True:
    w = float(input("\nINSERT YOUR WEIGHT IN KILOGRAMS OR 0 TO END: "))
    if w == 0:
        print("FINISHED.")
        break
    h = float(input("\nINSERT YOUR HEIGHT IN METERS OR 0 TO END: "))
    if h == 0:
        print("FINISHED.")
        break

    bmi = w / h**2

    state = ['UNDER WEIGHT', 'NORMAL WEIGHT', 'OVERWEIGHT', 'OBESE']
    if bmi <  18.5:
        print(f"\nYOUR BMI IS {bmi:.4f} AND YOU ARE {state[0]}.")
    elif bmi >18.5 and bmi < 24.9:
        print(f"\nYOUR BMI IS {bmi:.4f} AND YOU ARE {state[1]}.")
    elif bmi > 25.0 and bmi < 29.9:
        print(f"\nYOUR BMI IS {bmi:.4f} AND YOU ARE {state[2]}.")
    elif bmi > 30.0:
        print(f"\nYOUR BMI IS {bmi:.4f} AND YOU ARE {state[3]}.")
